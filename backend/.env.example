# Copy to .env for local development. Every value below is for development only.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-dev-only-secret-key
# Keys the JSHSHIR hashes stored in the database. Changing it later locks out every student,
# so in production generate it once, keep it safe, and don't reuse DJANGO_SECRET_KEY.
JSHSHIR_HASH_KEY=change-me-dev-only-jshshir-key
POSTGRES_DB=school_exam
POSTGRES_USER=postgres
POSTGRES_PASSWORD=parol
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Production only ----
# DJANGO_ALLOWED_HOSTS=bilimdon.uz
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bilimdon.uz
# REDIS_URL=redis://localhost:6379/1
# NUM_PROXIES=1
# QR_LOGIN_URL=https://bilimdon.uz/qr   (the pupil app's /qr page; with DEBUG it defaults to http://localhost:5173/qr)

# ---- Optional, defaults shown ----
# USE_TLS=True                     (defaults to the opposite of DJANGO_DEBUG)
# EXAM_GRACE_SECONDS=30
# QR_TOKEN_TTL_MINUTES=5
# THROTTLE_LOGIN_IP=300/min
# THROTTLE_LOGIN_IDENTIFIER=10/min
